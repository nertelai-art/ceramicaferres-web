# Cap d'aquestes variables és un secret. Aquest fitxer només en diu el nom i per a què serveix.

# Adreça pública del web, si es vol fixar a mà (https://ceramicaferres.com). A Vercel no cal:
# hi ha VERCEL_PROJECT_PRODUCTION_URL, que la plataforma posa sola.
SITE_URL=

# Posa-hi "true" només quan el web ja sigui al domini del client. Mentre és una proposta, no s'indexa.
SITE_INDEXABLE=

# --- Demo per a un lead (src/demo-kit) ---
# Amb DEMO_SECRET i DEMO_SITE, només s'entra amb un enllaç personal; la resta veu la pàgina de
# bloqueig de Nertel. Sense, la web és oberta. Es treuen quan la web passa a ser la del client.
# Secret per signar els enllaços (SECRET: només a Vercel i a .env.local, mai al repositori).
DEMO_SECRET=
# Identificador de la web als enllaços i a PostHog (ceramica-ferres).
DEMO_SITE=
# Adreça pública de la demo, per a l'ordre que fa els enllaços (pnpm demo:link).
DEMO_URL=
# Leads amb l'enllaç anul·lat, separats per comes (p. ex. ceramica-ferres).
DEMO_REVOKED=
# Webhook que rep un avís quan un lead obre la demo en un navegador nou (n8n, Slack…). Opcional.
DEMO_NOTIFY_URL=

# PostHog (núvol de la UE), el mateix projecte per a totes les demos. La clau de projecte és pública.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
