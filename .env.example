# Cap d'aquestes variables és un secret. Aquest fitxer només en diu el nom i per a què serveix.

# Adreça pública del web, si es vol fixar a mà (https://ceramicaferres.com). A Vercel no cal:
# hi ha VERCEL_PROJECT_PRODUCTION_URL, que la plataforma posa sola.
SITE_URL=

# Posa-hi "true" només quan el web ja sigui al domini del client. Mentre és una proposta, no s'indexa.
SITE_INDEXABLE=
